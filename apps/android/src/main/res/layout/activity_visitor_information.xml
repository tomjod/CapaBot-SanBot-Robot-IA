<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/visitor_screen_background"
    android:orientation="vertical"
    android:padding="@dimen/visitor_screen_padding">

    <!-- Compact company header strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/visitor_panel_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/visitor_panel_padding">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="64dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/visitor_information_logo_content_description"
            android:scaleType="centerInside"
            android:src="@drawable/busso_group_logo" />

        <TextView
            style="@style/VisitorBodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/visitor_spacing_md"
            android:layout_weight="1"
            android:text="@string/visitor_information_company_summary" />
    </LinearLayout>

    <!-- Two-column body fills the remaining height (landscape kiosk) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/visitor_spacing_md"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: companies / areas list (scrolls) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/visitor_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/visitor_panel_padding">

            <TextView
                style="@style/VisitorContactTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/visitor_information_companies_title" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbarSize="8dp">

                <LinearLayout
                    android:id="@+id/visitorInformationOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Right: selected detail (scrolls) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/visitor_spacing_md"
            android:layout_weight="1"
            android:background="@drawable/visitor_panel_background"
            android:orientation="vertical"
            android:padding="@dimen/visitor_panel_padding">

            <TextView
                style="@style/VisitorContactTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/visitor_information_detail_title" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/visitor_spacing_md"
                android:fillViewport="true"
                android:scrollbarSize="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/visitorInformationDetailLogo"
                        android:layout_width="@dimen/visitor_logo_lg_width"
                        android:layout_height="@dimen/visitor_logo_lg_height"
                        android:adjustViewBounds="true"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/visitorInformationDetailTitle"
                        style="@style/VisitorContactTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/visitor_spacing_md" />

                    <TextView
                        android:id="@+id/visitorInformationDetailSummary"
                        style="@style/VisitorContactMetaText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/visitor_spacing_sm" />

                    <TextView
                        android:id="@+id/visitorInformationDetail"
                        style="@style/VisitorBodyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/visitor_spacing_sm" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Fixed action bar: always visible, no scrolling needed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/visitor_spacing_md"
        android:orientation="horizontal">

        <Button
            android:id="@+id/visitorInformationBack"
            style="@style/VisitorSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_visitor_back"
            android:text="@string/visitor_information_back" />

        <Button
            android:id="@+id/visitorInformationTalk"
            style="@style/VisitorPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/visitor_spacing_md"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_visitor_talk"
            android:text="@string/visitor_information_talk" />
    </LinearLayout>

</LinearLayout>
